# Shared Postgres (the service creates and owns only the `hr` schema).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Verigence Security: sign-in verification (public keys) and permission checks.
SECURITY_BASE_URL=https://<security-host>
SECURITY_JWKS_URL=https://<security-host>/.well-known/jwks.json
SECURITY_ISSUER=
SECURITY_AUDIENCE=
SECURITY_CLIENT_ID=
SECURITY_CLIENT_SECRET=

# Optional.
HR_ENVIRONMENT=DEV
HR_ALLOWED_ORIGINS=https://<web-host>
HR_DB_POOL_SIZE=5
HR_DB_MAX_OVERFLOW=5

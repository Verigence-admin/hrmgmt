# Shared Postgres (the service creates and owns only the `hr` schema).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Verigence Security: sign-in verification (public keys) and permission checks.
SECURITY_BASE_URL=https://<security-host>
SECURITY_JWKS_URL=https://<security-host>/.well-known/jwks.json
SECURITY_ISSUER=
SECURITY_AUDIENCE=
SECURITY_CLIENT_ID=
SECURITY_CLIENT_SECRET=

# Optional.
HR_ENVIRONMENT=DEV
HR_ALLOWED_ORIGINS=https://<web-host>
HR_DB_POOL_SIZE=5
HR_DB_MAX_OVERFLOW=5

# Object storage: the existing S3-compatible (Cloudflare R2) bucket Audit Core already uses.
# Same endpoint, bucket and region as Audit Core's AUDIT_CORE_PHOTO_STORAGE_*; HR writes only
# under the `hr/` prefix. Prefer a key for this bucket created for HR, not Audit Core's own key.
HR_STORAGE_ENDPOINT=
HR_STORAGE_BUCKET=
HR_STORAGE_ACCESS_KEY_ID=
HR_STORAGE_SECRET_ACCESS_KEY=
HR_STORAGE_REGION=auto

# Audit Core: HR pulls project roles and outlet coordinates from here once a day (read-only).
AUDIT_CORE_BASE_URL=
# Google Maps (Geocoding): prints the street address on attendance photos. Optional; without it the
# photo carries the coordinates only and the record says so.
GOOGLE_MAPS_API_KEY=
